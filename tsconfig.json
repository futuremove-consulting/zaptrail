{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "next/server": ["tests/shims/next-server.ts"],
      "@supabase/supabase-js": ["tests/shims/supabase-js.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "api/**/*.ts",
    "src/server.ts",
    "src/packages/**/*.ts",
    "src/app/api/v1/**/*.ts",
    "tests/**/*.ts"
  ]
}
