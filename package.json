{
  "name": "@futuremove/zaptrail",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:quality-gates": "node scripts/check-quality-gates.mjs",
    "check:all": "node scripts/check-quality-gates.mjs && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
