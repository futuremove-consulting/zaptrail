flowchart TB
  Z[ZapTrack]
  Z --> APP[Aplicação externa]
  Z --> WA[Agente no WhatsApp]

  APP --> NOW[Agora]
  APP --> AREAS[Áreas da empresa]
  APP --> KNOW[Conhecimento]
  APP --> ANALYSIS[Análise]
  APP --> CONTROL[Controle]
  APP --> ASSIST[Assistente]

  NOW --> NOW1[Visão geral]
  NOW --> NOW2[Agenda e pendências]
  NOW --> NOW3[Atenção e atividade]

  subgraph AREAS_MAP[Áreas — mesmas entidades, recortes por contexto]
    SALES[Comercial]
    SERVICE[Atendimento]
    FIN[Financeiro]
    OPS[Operações]
    SUP[Suprimentos]
    PEOPLE[Pessoas]
    PROJECTS[Projetos]
    BOARD[Diretoria]
  end
  AREAS --> AREAS_MAP

  KNOW --> K1[Conversas]
  KNOW --> K2[Objetos de gestão]
  KNOW --> K3[Pessoas e organizações]
  KNOW --> K4[Arquivos e documentos]
  KNOW --> K5[Busca global]

  ANALYSIS --> A1[Indicadores]
  ANALYSIS --> A2[Relatórios e tendências]
  ANALYSIS --> A3[Histórico de decisões]

  CONTROL --> C1[Revisão da IA]
  CONTROL --> C2[Aprovações e automações]
  CONTROL --> C3[Fontes e integrações]
  CONTROL --> C4[Permissões, privacidade e auditoria]

  ASSIST --> AS1[Chat na aplicação]
  ASSIST --> AS2[Abrir no WhatsApp]

  WA --> W1[Consultar]
  WA --> W2[Registrar]
  WA --> W3[Revisar e confirmar]
  WA --> W4[Agir e receber atenção]

  NOW -.-> CORE[Núcleo semântico compartilhado]
  AREAS -.-> CORE
  KNOW -.-> CORE
  ANALYSIS -.-> CORE
  CONTROL -.-> CORE
  WA -.-> CORE

