# ZT-001: Project mode
APP_MODE=demo

# ZT-002: Supabase configuration
# Required for connecting to Supabase project
# Get credentials from: https://supabase.com/dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://zaptrail-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_PUBLIC_KEY_PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY_PLACEHOLDER

# ZT-003+: Feature flags
FEATURE_MockProvider=true
FEATURE_RealProvider=false

# ZT-013: WhatsApp provider type
# Options: 'mock' (default, always works), 'uazapi' (spike, requires valid account), 'evolution', 'waha'
WHATSAPP_PROVIDER_TYPE=mock